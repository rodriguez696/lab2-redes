systemctl start frr
ip addr add 172.16.0.56/30 dev eth0
ip addr add 203.0.113.13/30 dev eth1
ip addr add 172.16.0.61/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up


vtysh << 'EOF'
configure terminal
router ospf
ospf router-id 8.8.8.8
network 172.16.0.0/26 area 0
network 203.0.113.12/30 area 0
exit
interface eth0
ip ospf cost 1
shutdown
exit
interface eth1
ip ospf cost 1
shutdown
exit
interface eth2
ip ospf cost 1
shutdown
exit
exit
exit
EOF
