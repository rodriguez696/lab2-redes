systemctl start frr
ip addr add 172.16.0.6/30 dev eth0
ip addr add 172.16.0.9/30 dev eth1
ip addr add 172.16.0.13/30 dev eth2
ip addr add 172.16.0.45/30 dev eth3
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up

vtysh << 'EOF'
configure terminal
ip route 0.0.0.0/0 172.16.0.5
router ospf
ospf router-id 6.6.6.6
network 172.16.0.0/26 area 0
default-information originate always
exit
interface eth0
ip ospf cost 1
exit
interface eth1
ip ospf cost 1
exit
interface eth2
ip ospf cost 1
exit
interface eth3
ip ospf cost 1
exit
exit
exit
EOF
