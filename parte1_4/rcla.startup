ip addr add 203.0.113.10/30 dev eth0
ip addr add 192.168.72.1/30 dev eth1
ip addr add 203.0.113.14/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

ip route add 192.168.72.0/30 via 192.168.72.2 dev eth1
ip route add 203.0.113.0/29 via 203.0.113.9 dev eth0
ip route add default via 203.0.113.13 dev eth2

iptables -t nat -A POSTROUTING -s 192.168.72.2/30 -o eth0 -j SNAT --to 203.0.113.10
iptables -t nat -A POSTROUTING -s 192.168.72.2/30 -o eth2 -j SNAT --to 203.0.113.14
