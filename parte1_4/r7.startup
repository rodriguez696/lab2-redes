systemctl start frr
ip addr add 172.16.0.49/30 dev eth0
ip addr add 172.16.0.46/30 dev eth1
ip link set eth0 up
ip link set eth1 down

vtysh << 'EOF'
configure terminal
router ospf
ospf router-id 7.7.7.7
network 172.16.0.0/26 area 0
exit
interface eth0
ip ospf cost 1
exit
interface eth1
ip ospf cost 1
exit
exit
exit
EOF
