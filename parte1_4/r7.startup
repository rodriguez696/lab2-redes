systemctl start frr
ip addr add 172.16.0.54/30 dev eth0
ip addr add 172.16.0.46/30 dev eth1
ip addr add 172.16.0.49/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

vtysh << 'EOF'
configure terminal
ip route 0.0.0.0/0 172.16.0.54
router ospf
ospf router-id 7.7.7.7
network 172.16.0.0/26 area 0
default-information originate always
exit
interface eth0
ip ospf cost 1
exit
interface eth1
ip ospf cost 1
exit
interface eth2
ip ospf cost 1
exit
exit
EOF
