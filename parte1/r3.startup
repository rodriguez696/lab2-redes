systemctl start frr
ip addr add 172.16.0.22/30 dev eth0
ip addr add 172.16.0.34/30 dev eth1
ip addr add 172.16.0.41/30 dev eth2
ip addr add 203.0.113.9/30 dev eth3
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up

echo "Si va hacia A"
ip route add 203.0.113.8/30 via 203.0.113.10 dev eth3

echo "Si va hacia B"
ip route add 203.0.113.0/29 via 172.16.0.42 dev eth2

echo "Otro caso"
ip route add default via 172.16.0.21 dev eth0
