systemctl start frr
ip addr add 203.0.113.10/30 dev eth0
ip addr add 172.16.0.18/27 dev eth1
ip addr add 172.16.0.17/27 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

ip route add 192.168.72.0/30 via 172.16.0.3 dev eth2 
ip route add 10.72.0.0/25 via 172.16.0.11 dev eth1
ip route add default via 203.0.113.9 dev eth0
