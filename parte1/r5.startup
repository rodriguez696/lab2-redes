systemctl start frr
ip addr add 172.16.0.26/30 dev eth0
ip addr add 172.16.0.42/30 dev eth1
ip addr add 172.16.0.30/30 dev eth2
ip addr add 172.16.0.14/30 dev eth3
ip addr add 203.0.113.1/30 dev eth4
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up
ip link set eth4 up


vtysh << 'EOF'
configure terminal
ip route 203.0.113.4/30 203.0.113.2
router ospf
ospf router-id 5.5.5.5
network 172.16.0.0/26 area 0
network 203.0.113.0/30 area 0
redistribute static
exit
exit
exit
EOF

