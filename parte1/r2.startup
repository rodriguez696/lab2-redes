systemctl start frr
ip addr add 172.16.0.11/27 dev eth0
ip addr add 172.16.0.8/27 dev eth1
ip addr add 172.16.0.10/27 dev eth2
ip addr add 172.16.0.9/27 dev eth3
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up

ip route add 192.168.72.0/30 via 172.16.0.2 dev eth1
ip route add 10.72.0.0/25 via 172.16.0.5 dev eth3
ip route add default via 172.16.0.18 dev eth0
