systemctl start frr
ip addr add 172.16.0.18/30 dev eth0
ip addr add 172.16.0.33/30 dev eth1
ip addr add 172.16.0.37/30 dev eth2
ip addr add 172.16.0.25/30 dev eth3
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up

vtysh << 'EOF'
configure terminal
router ospf
ospf router-id 2.2.2.2
network 172.16.0.0/26 area 0
exit
exit
exit
EOF
