systemctl start frr
ip addr add 172.16.0.6/30 dev eth0
ip addr add 172.16.0.9/30 dev eth1
ip addr add 172.16.0.13/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

echo "Cualquier trafico dirigido a los clientes ya sea A o B, su camino optimo es ir a r5"
ip route add 203.0.113.0/28 via 172.16.0.14 dev eth2

ip route add default via 172.16.0.5 dev eth0
