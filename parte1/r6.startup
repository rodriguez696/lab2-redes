systemctl start frr
ip addr add 172.16.0.6/30 dev eth0
ip addr add 172.16.0.9/30 dev eth1
ip addr add 172.16.0.13/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

vtysh << 'EOF'
configure terminal
router ospf
ospf router-id 6.6.6.6
network 172.16.0.0/26 area 0
network 8.8.8.0/24 area 3
exit
exit
exit
EOF
